# Copy to `.env.local` and fill in from the Firebase console:
# Project settings -> Your apps -> Web app (`</>`).
#
# A Firebase web config is not a secret. It identifies the project; access is
# controlled entirely by firestore.rules.
#
# These values are identical to the web FirebaseOptions in
# close_by/lib/firebase_options.dart, so both clients talk to the same project.

VITE_FIREBASE_API_KEY=AIzaSyD2ZTMxp5QRaHkP7qVhZxIVAqm5x9wOmbY
VITE_FIREBASE_AUTH_DOMAIN=closeby-28cdc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=closeby-28cdc
VITE_FIREBASE_STORAGE_BUCKET=closeby-28cdc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=761711794489
VITE_FIREBASE_APP_ID=1:761711794489:web:527c1dc8bd91ceeab8b0e8

# ─── Local emulator only ───────────────────────────────────────────────────────
# Leave these unset to read the live project, which is the normal case.
#
# Set VITE_FIRESTORE_EMULATOR=true and run `npm run emulator` in another terminal
# to read seeded data under the proposed security rules instead. The port must
# match `emulators.firestore.port` in firebase.emulator.json.
#
# VITE_FIRESTORE_EMULATOR=true
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8180